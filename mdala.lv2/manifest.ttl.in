@prefix lv2: <http://lv2plug.in/ns/lv2core#> .
@prefix mdala: <http://drobilla.net/plugins/mdala/> .
@prefix pg: <http://lv2plug.in/ns/ext/port-groups#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

mdala:stereoIn
	a pg:StereoGroup ,
		pg:InputGroup ;
	lv2:name "Input" ;
	lv2:symbol "in" .

mdala:stereoOut
	a pg:StereoGroup ,
		pg:OutputGroup ;
	pg:source mdala:stereoIn ;
	lv2:name "Output" ;
	lv2:symbol "out" .

