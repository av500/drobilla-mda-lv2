@prefix lv2: <http://lv2plug.in/ns/lv2core#> .
@prefix pset: <http://lv2plug.in/ns/ext/presets#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .



<default-preset>
	a pset:Preset ;
	lv2:appliesTo <http://drobilla.net/plugins/mda/Detune> ;
	rdfs:label "detune" ;
	lv2:port [
		lv2:symbol "detune" ;
		pset:value 2.4
	] , [
		lv2:symbol "mix" ;
		pset:value 90.0
	] , [
		lv2:symbol "output" ;
		pset:value 0.0
	] , [
		lv2:symbol "latency" ;
		pset:value 0.5
	] .
